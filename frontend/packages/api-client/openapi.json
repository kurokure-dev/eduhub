            "format": "int64"
          },
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "place": {
            "type": "string"
          },
          "capacity": {
            "type": "integer",
            "format": "int32"
          },
          "status": {
            "type": "string",
            "enum": [
              "OPEN",
              "CLOSED"
            ]
          },
          "confirmedCount": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "SessionRequest": {
