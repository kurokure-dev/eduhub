    "/api/me/enrollments/{enrollmentId}/cancel": {
      "post": {
        "tags": [
          "Enrollment"
        ],
        "summary": "내 신청 취소",
        "description": "확정·대기 신청을 취소한다. 확정을 취소하면 대기 1순위가 확정으로 승급한다 (D-01, D-52). 본인 신청만 취소할 수 있고 남의 신청은 없는 신청처럼 404다 (D-45). 마감된 회차의 신청은 취소할 수 없다 (D-02).",
        "operationId": "cancel",
        "parameters": [
          {
            "name": "enrollmentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "취소됨 (status=CANCELLED, waitingRank=null)",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/EnrollmentResponse"
                }
              }
            }
          },
          "401": {
            "description": "토큰이 없거나 유효하지 않음",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404": {
            "description": "없는 신청이거나 본인 신청이 아님",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "409": {
            "description": "마감된 회차이거나 확정·대기 상태가 아님 (수료, 이미 취소)",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
