            "minLength": 0
          },
          "category": {
            "type": "string",
            "description": "분류",
            "example": "개발",
            "maxLength": 50,
            "minLength": 0
          },
          "description": {
            "type": "string",
            "description": "설명 (선택)",
            "example": "Spring Boot 기초 과정",
            "maxLength": 2000,
            "minLength": 0
          }
        },
        "required": [
          "category",
          "title"
        ]
      },
      "ProblemDetail": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
