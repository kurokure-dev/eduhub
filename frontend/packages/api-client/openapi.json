      "get": {
        "tags": [
          "Enrollment"
        ],
        "summary": "내 신청 내역 조회",
        "description": "로그인한 사용자의 신청 내역을 최근 신청순으로 돌려준다. 대기(WAITING) 건에는 현재 대기 순번(waitingRank)이 붙는다 (D-09). 대상은 요청 값이 아니라 로그인 토큰의 사번으로 정해진다 (D-44).",
        "operationId": "findMine",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "description": "상태 (없으면 전체)",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "CONFIRMED",
                "WAITING",
                "CANCELLED",
                "COMPLETED"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "내 신청 내역 (없으면 빈 목록)",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MyEnrollmentResponse"
                  }
                }
              }
            }
          },
          "400": {
            "description": "status 값이 잘못됨",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "401": {
            "description": "토큰이 없거나 유효하지 않음",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
