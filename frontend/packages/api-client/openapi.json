            "example": 20,
            "minimum": 1
          }
        },
        "required": [
          "capacity",
          "place",
          "startDate"
        ]
      },
      "EnrollmentResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "sessionId": {
            "type": "integer",
