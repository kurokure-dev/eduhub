    "/api/v1/sessions/{sessionId}/enrollments": {
      "post": {
        "tags": [
          "Enrollment"
        ],
        "summary": "수강 신청",
        "description": "회차에 신청한다. 자리가 있고 대기자가 없으면 확정(CONFIRMED), 아니면 대기(WAITING)로 등록된다 (D-35). 신청자는 요청 본문이 아니라 로그인 토큰의 사번으로 정해진다 (D-44). 같은 회차에 확정·대기 신청이 이미 있으면 거절하지만, 취소 후 재신청은 된다 (D-07). 마감된 회차는 신청할 수 없다.",
        "operationId": "enroll",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "신청됨 (확정 또는 대기)",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/EnrollmentResponse"
                }
              }
            }
          },
          "401": {
            "description": "토큰이 없거나 유효하지 않음",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404": {
            "description": "없는 회차",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "409": {
            "description": "마감된 회차이거나 이미 신청함 (수료한 회차 포함, D-49)",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/sessions/{sessionId}/completions": {
      "post": {
        "tags": [
          "Admin Enrollment"
        ],
        "summary": "수료 처리",
        "description": "사번 목록의 확정자를 수료로 바꾼다. 회차 시작일 당일부터 할 수 있고, 그 전이면 409다 (D-47). 사번마다 판정해 부분 성공을 허용하며, 실패한 사번은 사유 코드(WAITING, NOT_ENROLLED, ALREADY_COMPLETED)와 함께 돌려준다. 사번은 trim 후 대소문자를 무시해 비교하고 중복은 처음 것만 처리한다 (D-48).",
        "operationId": "complete",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompletionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "처리됨 (부분 성공 포함)",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CompletionResponse"
                }
              }
            }
          },
          "400": {
            "description": "입력값 오류 (본문 없음, 빈 목록, 201개 이상, 빈 사번, 20자 초과 사번)",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "401": {
            "description": "인증 필요",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "403": {
            "description": "관리자 권한 필요",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404": {
            "description": "없는 회차",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "409": {
            "description": "회차 시작일 전",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/courses": {
      "get": {
        "tags": [
          "AdminCourse"
        ],
        "summary": "관리자 과정 목록 조회",
        "description": "종료된 과정을 포함해 페이지 단위로 조회한다 (D-34). status를 주면 그 상태만 조회한다. page는 0부터, 기본 정렬은 id 내림차순, 기본 크기는 10이다. 정렬 가능한 필드: id, title, category, status",
        "operationId": "searchAdminCourses",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "description": "상태 (없으면 전체)",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "OPEN",
                "CLOSED"
              ]
            }
          },
          {
            "name": "keyword",
            "in": "query",
            "description": "제목 검색어 (부분 일치)",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "description": "분류 (정확히 일치)",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Zero-based page index (0..N)",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0,
              "minimum": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "description": "The size of the page to be returned",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10,
              "minimum": 1
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Sorting criteria in the format: property,(asc|desc). Default sort order is ascending. Multiple sort criteria are supported.",
            "required": false,
            "schema": {
              "type": "array",
              "default": [
                "id,DESC"
              ],
              "items": {
                "type": "string"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponseAdminCourseSummaryResponse"
                }
              }
            }
          },
          "400": {
            "description": "정렬할 수 없는 필드",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "401": {
            "description": "인증 필요",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "403": {
            "description": "관리자 권한 필요",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "AdminCourse"
        ],
        "summary": "과정 등록",
        "description": "운영 중(OPEN) 상태의 과정을 등록한다.",
        "operationId": "createCourse",
